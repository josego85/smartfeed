DATABASE_URL=postgresql://smartfeed:smartfeed@localhost:5432/smartfeed
REDIS_URL=redis://localhost:6379

# LLM — default: local Ollama
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2
OLLAMA_BASE_URL=http://localhost:11434

# Cloud providers (optional, only needed when LLM_PROVIDER matches)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=

CORS_ORIGINS=["http://localhost:3000"]

# ── Tuning (all have defaults, only set to override) ──────────────────────────

# HTTP timeout in seconds for RSS fetching and Ollama embedding requests
# HTTP_TIMEOUT=30

# Ollama embedding model — must match EMBEDDING_DIM below
# EMBEDDING_MODEL=nomic-embed-text

# Embedding vector size — must match the model above (nomic-embed-text=768)
# Changing this requires recreating the database (docker compose down -v)
# EMBEDDING_DIM=768

# Number of characters passed to the classifier (more dilutes the topic signal)
# MAX_CLASSIFY_CHARS=500

# Number of characters sent to the LLM summarizer
# MAX_SUMMARIZE_CHARS=4000

# Parallel enrichment tasks (classify + summarize) per sync job
# SYNC_CONCURRENCY=3

# Articles API pagination
# ARTICLES_DEFAULT_LIMIT=50
# ARTICLES_MAX_LIMIT=200

# Semantic search API
# SEARCH_DEFAULT_RESULTS=10
# SEARCH_MAX_RESULTS=50
# SEARCH_MIN_QUERY_LENGTH=2

# ARQ worker
# WORKER_MAX_JOBS=10
# WORKER_JOB_TIMEOUT=600

# SSE keepalive — seconds to wait for a Redis pub/sub message before sending a ping
# PUBSUB_TIMEOUT=15.0

# Seconds to wait when reading a completed job result from ARQ
# JOB_RESULT_TIMEOUT=5
